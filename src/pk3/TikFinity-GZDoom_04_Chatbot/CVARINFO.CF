server noarchive bool		CV_b_API_dataReady = false;
*/


// Add Chat Functions
user bool	CV_b_CF_Received_Enable = true;
user bool	CV_b_CF_Received_ColorCustom = false;
user color 	CV_c_CF_Received_Color;
user string CV_f_CF_Received_Font = "smallfont";
user string CV_s_CF_Received_Text = "Chat";
user string CV_s_CF_Received_Name = "Chatter";
user bool	CV_b_CF_Received_TF = false;
user int	CV_n_CF_Received_Style = 0; 	//0 - Print
											//1 - HudCenter
											




server noarchive string		CV_s_TF_sanitized_user = "asciiOnlyNoEmoji";

//From External Pipe API
server noarchive string		CV_s_API_summon_username = "";
server noarchive string 	CV_s_API_summon_classname = "";
server noarchive bool 		CV_b_API_summon_buddy = false;
server noarchive int 		CV_n_API_summon_size = 0;
server noarchive int 		CV_n_API_summon_points = 0;


// Streamer.Bot - Chatbot
user bool 					CV_b_SB_Chatbot_Enable = true;
user int					CV_n_SB_Chatbot_Prefix = 1; // 1: "Playername: ", 2: Custom
user string					CV_s_SB_Chatbot_Prefix = "CHAT: ";

server noarchive string		CV_s_SB_Chatbot_Message = "username does a thing"; // string to parse for Streamer.bot chatbot

//For BetterSpawn: From action consoleCommand




// BetterSpawn Control & Status
// for use with puke 444
server noarchive string CV_s_betterspawn_classname = "empty"; // since blank isn't an option, setting it to 'empty' is the next best thing.
server noarchive int	CV_n_betterspawn_Target_TID = -1; //Target TID value of spawned actor
server noarchive int	CV_n_betterspawn_Actual_TID = -1; // Actual TID of spawned actor
server noarchive bool	CV_b_betterspawn_SpawnSuccess = false;
// BetterSpawn Configuration
user int CV_n_betterspawn_radialOffset = 64;
user float CV_f_betterspawn_radialOffset = 64.0;
user int CV_n_betterspawn_teleportfog = 1; // 0-Always Off, 1-Enabled (per call basis), 2-Always On

// Debugging
user noarchive bool CV_b_debug = false;
user noarchive bool CV_b_verbose = true;


// Simulator
user int CV_n_simulator_ticks = 175;

// Game Modes
user int		CV_n_TF_PointsSource = 0;
user bool		CV_b_TF_ShotClock = false;
user int		CV_n_TF_ShotClock_Seconds = 20;
user bool		CV_b_TF_ShotClock_Despawn = false;
user bool		CV_b_TF_ShowModeAtLevelStart = true;


// Monster Nametag
