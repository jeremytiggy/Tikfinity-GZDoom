function void interactiveSummonTier1Foe(void)
{
	int points = 200;
	str classname;
	int size;
	switch (random(1,4))
	{
		case 1: classname="Zombieman";size=1;break;
		case 2: classname="ShotgunGuy";size=1;break;
		case 3: classname="DoomImp";size=1;break;
		case 4: classname="LostSoul";size=1;break;
	}
	interactiveSummonFoe(classname,size,points);
}
function void interactiveSummonTier1Buddy(void)
{
	int points = 0;
	str classname;
	int size;
	switch (random(1,4))
	{
		case 1: classname="Zombieman";size=1;break;
		case 2: classname="ShotgunGuy";size=1;break;
		case 3: classname="DoomImp";size=1;break;
		case 4: classname="LostSoul";size=1;break;
	}
	interactiveSummonBuddy(classname,size);
}
function void interactiveSummonTier2Foe(void)
{
	int points = 150;
	str classname;
	int size;
	switch (random(1,4))
	{
		case 1: classname="ChaingunGuy";size=1;break;
		case 2: classname="Demon";size=1;break;
		case 3: classname="Spectre";size=1;break;
		case 4: classname="Cacodemon";size=1;break;
	}
	interactiveSummonFoe(classname,size,points);
}
function void interactiveSummonTier2Buddy(void)
{
	str classname;
	int size;
	switch (random(1,2))
	{
		case 1: classname="ChaingunGuy";size=1;break;
		case 2: classname="Cacodemon";size=1;break;
	}
	interactiveSummonBuddy(classname,size);
}
function void interactiveSummonTier3Foe(void)
{
	int points = 100;
	str classname;
	int size;
	switch (random(1,6))
	{
		case 1: classname="HellKnight";size=2;break;
		case 2: classname="BaronOfHell";size=2;break;
		case 3: classname="Revenant";size=2;break;
		case 4: classname="Arachnotron";size=2;break;
		case 5: classname="Fatso";size=2;break;
		case 6: classname="ArchVile";size=2;break;
	}
	interactiveSummonFoe(classname,size,points);
}
function void interactiveSummonTier3Buddy(void)
{
	str classname;
	int size;
	switch (random(1,2))
	{
		case 1: classname="ArchVile";size=2;break;
		case 2: classname="PainElemental";size=1;break;
	}
	interactiveSummonBuddy(classname,size);
}
function void interactiveSummonTier4Foe(void)
{
	int points = 50;
	str classname;
	int size;
	switch (random(1,2))
	{
		case 1: classname="Cyberdemon";size=3;break;
		case 2: classname="SpiderMastermind";size=3;break;
	}
	interactiveSummonFoe(classname,size,points);
}
function void interactiveSummonTier4Buddy(void)
{
	str classname;
	int size;
	classname="Cyberdemon";size=3;
	interactiveSummonBuddy(classname,size);
}
script 672 (void)
{
    int frequency_ticks = 6*35;

    while (1)
    {
        int roll = random(1,65);
		switch (roll)
		{
			case 1: interactiveSummonTier1Foe(); Log(s:"Roll: ",d:roll,s:". Tier 1 Foe.");break;
			case 2: interactiveSummonTier2Foe(); Log(s:"Roll: ",d:roll,s:". Tier 2 Foe.");break;
