function int n_FixedPointToInteger(int f_fixed)
{
	int n_integer = 0;
	if (f_fixed < 32768) return n_integer; // rounding threshold

	int f_abs;
	int n_sign;

	if (f_fixed > 0)
	{
		f_abs  = f_fixed;
		n_sign = 1;
	}
	if (f_fixed < 0)
	{
		f_abs  = FixedMul(-1.0, f_fixed);
		n_sign = -1;
	}

	int n_abs = ((f_abs + 32768) >> 16);
	return n_sign * n_abs;
}

function int f_IntegerToFixedPoint(int n_integer)
{
	if (n_integer == 0) return 0.0;

	int n_abs;
	int f_sign;

	if (n_integer > 0)
	{
		n_abs  = n_integer;
		f_sign = 1.0;
	}
	if (n_integer < 0)
	{
		n_abs  = -n_integer;
		f_sign = -1.0;
	}

	int f_abs = (n_abs << 16);
	return FixedMul(f_sign, f_abs);
}

function int n_IntegerFixedMixedMul(int n_integer, int f_fixed)
{
	if ((n_integer == 0) || (f_fixed == 0)) return 0;

	int f_integer = f_IntegerToFixedPoint(n_integer);
	int f_product = FixedMul(f_integer, f_fixed);
	return n_FixedPointToInteger(f_product);
}

function int f_NormalizeFPA(int f_angle_FPA)
{
	return ((f_angle_FPA % 1.0) + 1.0) % 1.0;
}

function int f_WholeDegreesToFPA(int n_degrees)
{
	n_degrees = n_degrees % 360;
	int f_deg  = f_IntegerToFixedPoint(n_degrees);
	int f_turn = FixedDiv(f_deg, 360.0);
	int f_angle_FPA = f_NormalizeFPA(f_turn);
	return f_angle_FPA;
}

function int f_AddFPA(int f_a_FPA, int f_b_FPA)
{
	f_a_FPA = f_NormalizeFPA(f_a_FPA);
	f_b_FPA = f_NormalizeFPA(f_b_FPA);
	int f_sum_FPA = f_NormalizeFPA(f_a_FPA + f_b_FPA);
	return f_sum_FPA;
}

function int f_SubtractFPA(int f_a_FPA, int f_b_FPA)
{
	f_a_FPA = f_NormalizeFPA(f_a_FPA);
	f_b_FPA = f_NormalizeFPA(f_b_FPA);
	int f_difference_FPA = f_NormalizeFPA(f_a_FPA - f_b_FPA);
	return f_difference_FPA;
}

function int f_IntegerTicksToFixedSeconds(int n_ticks)
{
	if (n_ticks <= 0) return 0;

	int f_ticks = f_IntegerToFixedPoint(n_ticks);
	int f_tps   = f_IntegerToFixedPoint(35);
	int f_seconds = FixedDiv(f_ticks, f_tps);
	return f_seconds;
}

