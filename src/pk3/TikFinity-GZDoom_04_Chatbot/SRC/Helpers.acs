//  Helper:  Show Game Mode
script 673 (void)
{
	str modeText = "";
	if  (n_TF_pointsGameMode  == 1) 
	{
		modeText = StrParam(s:modeText,s:"\n",s:"Game Mode: Tiered Scoring\nInfantry +200\nDemons +150\nHeavyHitters +100\nCyberdemon +50");
		SetFont("bigfont");
		HUDMessage(s:modeText; HUDMSG_TYPEON, UniqueTID(), 11, GetCVAR("CV_f_TF_obituaryX"), GetCVAR("CV_f_TF_obituaryY"), 5.0, 0.01, 2.0);	
	}
}
script 674 (void)
{
	
	//SpaceGhost
	sethudsize(640,480,false);
	SetFont("TKTOW0");
	HudMessage(s:"A";HUDMSG_FADEINOUT,0,CR_UNTRANSLATED, 320.0, 240.0, 7.0,1.0,1.0);
	
	
	//Leaderboard
	SetFont("bigfont");
	str s_Leaderboard = StrParam(s:"1st Place: ",s:DB_Key[PlayerNumber()][0],s:"   ",d:DB_Val[PlayerNumber()][0],s:" points\n",
									s:"2nd Place: ",s:DB_Key[PlayerNumber()][1],s:"   ",d:DB_Val[PlayerNumber()][1],s:" points\n",
									s:"3rd Place: ",s:DB_Key[PlayerNumber()][2],s:"   ",d:DB_Val[PlayerNumber()][2],s:" points");
	HUDMessage(s:s_Leaderboard; HUDMSG_TYPEON,0,CR_UNTRANSLATED,320.0,240.0,7.0);	
}