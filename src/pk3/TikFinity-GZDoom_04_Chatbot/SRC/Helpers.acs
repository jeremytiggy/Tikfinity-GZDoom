// Option B (future): extract projection to a reusable helper
// -----------------------------------------------------------------------------
/*
function bool ProjectActorToHUD(
	int n_TID,
	int n_HudWidth_px,
	int n_HudHeight_px,
	int n_DrawDistanceMax_px,
	int f_xOffsetPct,
	int f_yOffsetPct,
	out int f_outX_FPPx,
	out int f_outY_FPPx
)
{
	// Returns true if actor is projectable and within view constraints.
	// Computes perspective projection from player view to HUD space.
	// Outputs fixed-point HUD pixel coordinates.
}
*/

// -----------------------------------------------------------------------------
// Primary function (Option A applied; Option C comments included)
// -----------------------------------------------------------------------------

function void HudMessageOnActorNew(
	int n_TID,
	int n_msgID,
	int n_SetHudSize_X_px,
	int n_SetHudSize_Y_px,
	int f_Text_XOffsetPct,
	int f_Text_YOffsetPct,
	int n_DrawDistanceMax_px,
	str s_fontname,
	bool b_sprite,
	str s_text,
	int n_holdTime_ticks,
	int n_HudMsg_Color_CR
)
{
	// ---- Time normalization ----
	int n_holdMin_ticks = 1;
	if (n_holdTime_ticks < n_holdMin_ticks)
		n_holdTime_ticks = n_holdMin_ticks;

	int f_holdTime_seconds = f_IntegerTicksToFixedSeconds(n_holdTime_ticks);
	if (f_holdTime_seconds < 0.1) f_holdTime_seconds = 0.1;

	// ---- Color sanitation (CR_* only) ----
	bool b_colorInvalid =
		(n_HudMsg_Color_CR < 0) ||
		(n_HudMsg_Color_CR == 11) ||
		(n_HudMsg_Color_CR > 25);

	if (b_colorInvalid)
		n_HudMsg_Color_CR = CR_WHITE;

	// ---- HUD size defaults ----
	if (n_SetHudSize_X_px <= 0) n_SetHudSize_X_px = 640;
	if (n_SetHudSize_Y_px <= 0) n_SetHudSize_Y_px = 480;

	int n_HudWidth_px  = n_SetHudSize_X_px;
	int n_HudHeight_px = n_SetHudSize_Y_px;
	int n_HudMidX_px   = n_HudWidth_px  / 2;
	int n_HudMidY_px   = n_HudHeight_px / 2;

	// ---- Offset normalization (ratios) ----
	if (f_Text_XOffsetPct < -1.0) f_Text_XOffsetPct = -1.0;
	if (f_Text_XOffsetPct >  1.0) f_Text_XOffsetPct =  1.0;
	if (f_Text_YOffsetPct < -1.0) f_Text_YOffsetPct = -1.0;
	if (f_Text_YOffsetPct >  1.0) f_Text_YOffsetPct =  1.0;

	int n_XOffsetMax_px = n_HudWidth_px  / 2;
	int n_YOffsetMax_px = n_HudHeight_px / 2;
	int n_XOffset_px   = n_IntegerFixedMixedMul(n_XOffsetMax_px, f_Text_XOffsetPct);
	int n_YOffset_px   = n_IntegerFixedMixedMul(n_YOffsetMax_px, f_Text_YOffsetPct);

	// ---- World-space positions (WU) ----
	int f_playerX_WU = GetActorX(0);
	int f_playerY_WU = GetActorY(0);
	int f_playerZ_WU = GetActorZ(0);

	int f_actorX_WU = GetActorX(n_TID);
	int f_actorY_WU = GetActorY(n_TID);
	int f_actorZ_WU = GetActorZ(n_TID);

	// ---- Relative vectors (player → actor) ----
	int f_vecX_WU = f_actorX_WU - f_playerX_WU;
	int f_vecY_WU = f_actorY_WU - f_playerY_WU;

	int n_PlayerHeight_px   = 41;
	int f_PlayerHeight_FPPx = f_IntegerToFixedPoint(n_PlayerHeight_px);

	int f_vecZ_WU = f_actorZ_WU - (f_playerZ_WU + f_PlayerHeight_FPPx);

	// ---- Angles (engine-native FPA) ----
	int f_playerHeading_FPA = GetActorAngle(0);
	int f_azimuth_FPA       = VectorAngle(f_vecX_WU, f_vecY_WU);
	int f_relBearing_FPA    = f_SubtractFPA(f_azimuth_FPA, f_playerHeading_FPA);

	// ---- Distance approximation (screen-plane) ----
	int f_lrSelector = (f_azimuth_FPA + 0.125) % 0.5;
	bool b_actorRight = (f_lrSelector > 0.25);

	int f_distance_FPPx;
	if (b_actorRight)
		f_distance_FPPx = FixedDiv(f_vecY_WU, sin(f_azimuth_FPA));
	else
		f_distance_FPPx = FixedDiv(f_vecX_WU, cos(f_azimuth_FPA));

	int n_distance_px = n_FixedPointToInteger(f_distance_FPPx);

	// ---- View gating (left/right FOV & distance) ----
	int n_FOV_LR_deg = 72;
	int f_FOV_LR_FPA = FixedDiv(f_IntegerToFixedPoint(n_FOV_LR_deg), 360.0);

	bool b_inLR =
		(f_relBearing_FPA < f_FOV_LR_FPA) ||
		(f_relBearing_FPA > (1.0 - f_FOV_LR_FPA));

	bool b_inRange = (n_distance_px < n_DrawDistanceMax_px);

	// ---- Vertical gating (player pitch) ----
	int n_FOV_UD_deg = 45;
	int f_FOV_UD_FPA = FixedDiv(f_IntegerToFixedPoint(n_FOV_UD_deg), 360.0);
	int f_playerPitch_FPA = GetActorPitch(0);

	bool b_pitchOK =
		(f_playerPitch_FPA > -f_FOV_UD_FPA) &&
		(f_playerPitch_FPA <  f_FOV_UD_FPA);

	if (!(b_inLR && b_inRange && b_pitchOK)) return;

	// ---- Projection: horizontal ----
	int f_xNumer_FPPx = n_HudMidX_px * sin(f_relBearing_FPA);
	int f_xDenom      = cos(f_relBearing_FPA);
	if ((f_xNumer_FPPx == 0) || (f_xDenom == 0)) return;

	int f_xProj_FPPx = FixedDiv(f_xNumer_FPPx, f_xDenom);
	int n_x_px       = n_HudMidX_px - n_FixedPointToInteger(f_xProj_FPPx) + n_XOffset_px;
	int f_xOut_FPPx  = f_IntegerToFixedPoint(n_x_px);

	// ---- Projection: vertical ----
	int f_absPitch_FPA    = VectorAngle(f_distance_FPPx, f_vecZ_WU);
	int f_screenPitch_FPA = f_AddFPA(f_absPitch_FPA, f_playerPitch_FPA);

	int f_yNumer_FPPx = n_HudMidX_px * sin(f_screenPitch_FPA);
	int f_yDenom      = cos(f_screenPitch_FPA);
	if ((f_yNumer_FPPx == 0) || (f_yDenom == 0)) return;

	int f_yProj_FPPx = FixedDiv(f_yNumer_FPPx, f_yDenom);
	int n_y_px       = n_HudMidY_px - n_FixedPointToInteger(f_yProj_FPPx) + n_YOffset_px;
	int f_yOut_FPPx  = f_IntegerToFixedPoint(n_y_px);

	// ---- Draw ----
	if (s_fontname != "")
	{
		SetFont(s_fontname);
		if (b_sprite) s_text = "A";
	}
	else
	{
		SetFont("smallfont");
	}

	SetHudSize(n_HudWidth_px, n_HudHeight_px, 1);
	HudMessage(
		s:s_text;
		HUDMSG_PLAIN,
		n_msgID,
		n_HudMsg_Color_CR,
		f_xOut_FPPx,
		f_yOut_FPPx,
		f_holdTime_seconds
	);
	SetHudSize(0, 0, false);
}
function str AorAn(str word)
{
	bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	if (verbose) Log(s:"word: ",s:word,s:", StrLen: ",d:StrLen(word));
	str article = "A";
	if (StrLen(word) < 1) return article;
	int charValue = GetChar(word, 0);
	if (verbose) Log(s:"char: ",c:charValue,s:" (",d:charValue,s:")");
	switch (charValue)
	{
		case 65: //A
			article = "An";
			break;
		case 69: //E
			article = "An";
			break;
		case 73: //I
			article = "An";
			break;
		case 79: //O
			article = "An";
			break;
		case 85: //U
			article = "An";
			break;
		case 97: //a
			article = "an";
			break;
		case 101: //e
			article = "an";
			break;
		case 105: //i
			article = "an";
			break;
		case 111: //o
			article = "an";
			break;
		case 117: //u
			article = "an";
			break;
		default:
			if (charValue < 97) article = "A";
			else article = "a";
			break;		
	}
	if (verbose) Log(s:"article: ",s:article);
	return article;
}

function str FindReplaceString(str input, str findSubstring, str replaceSubstring)
{
    str output = "";
    int inputLen = StrLen(input);
    int findLen  = StrLen(findSubstring);

    int i = 0;

    while (i < inputLen)
    {
        int match = 1;

        // Check for substring match at position i
        for (int j = 0; j < findLen; j++)
        {
            if (i + j >= inputLen ||
                GetChar(input, i + j) != GetChar(findSubstring, j))
            {
                match = 0;
                break;
            }
        }

        if (match && findLen > 0)
        {
            // Append replacement string
            for (int k = 0; k < StrLen(replaceSubstring); k++)
            {
                output = StrParam(s:output, c:GetChar(replaceSubstring, k));
            }

            i += findLen;
        }
        else
        {
            // Copy single character
            output = StrParam(s:output, c:GetChar(input, i));
            i++;
        }
    }

    return output;
}


function str ReplaceUnderScoresWithSpaces(str stringWithUnderscores)
{
	bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	if (verbose) { Log(s:"function str ReplaceUnderScoresWithSpaces(",s:stringWithUnderscores,s:")"); }
	int inputStringLength = StrLen(stringWithUnderscores);
	str outputString = "";
	if (verbose) {	Log(s:"stringWithUnderscores: ",s:stringWithUnderscores);
					Log(s:"inputStringLength: ",d:inputStringLength); 
					Log(s:"outputString: ",s:outputString); }
    

    for (int i = 0; i < inputStringLength; i++)
    {
        if (verbose) {	Log(s:"i: ",d:i);	}
		int singleCharacter = GetChar(stringWithUnderscores, i);
		if (verbose) {	Log(s:"singleCharacter: ",c:singleCharacter);	}

        if (singleCharacter == '_')
        {
            //outputString = StrParam(s:s(outputString), c:' ');
			if (verbose) {	Log(s:"outputString = StrParam(s:",s:outputString,s:", c:' ');");	}
			outputString = StrParam(s:outputString, c:' ');
        }
        else
        {
            //outputString = StrParam(s:s(outputString), c:singleCharacter);
			if (verbose) {	Log(s:"outputString = StrParam(s:",s:outputString,s:", c:",s:singleCharacter,s:");");	}
			outputString = StrParam(s:outputString, c:singleCharacter);
        }
		if (verbose) {	Log(s:"outputString: ",s:outputString);	}
    }
	if (verbose) {	Log(s:"return outputString: ",s:outputString);	}
	return outputString;
}




function str s_randomVerbed(void)
{
	str verbed = "";
	switch (random(0,13))
	{
		case 0: verbed = "took out"; 			break;
		case 1: verbed = "punked"; 				break;
		case 2: verbed = "beat up"; 			break;
		case 3: verbed = "reverse Doom-slayed"; break;
		case 4: verbed = "murderated"; 			break;
		case 5: verbed = "done killed"; 		break;
		case 6: verbed = "slap-dangled"; 		break;
		case 7: verbed = "saved"; 				break;
		case 8: verbed = "baptized";			break;
		case 9: verbed = "damnated";			break;
		case 10: verbed = "drank";				break;
		case 11: verbed = "gibbed";				break;
		case 12: verbed = "wallopped";			break;
		case 13: 
			if (random(1,100) == 1)
			{
				switch (random(0,4))
				{
					case 0: verbed = "blippity-blip-blip-bloppity-bloo'd"; break;
					case 1: verbed = "SHOO'd"; break;
					case 2: verbed = "reverse-Listed"; break;
					case 3: verbed = "Ripped & Tore"; break;
					case 4: verbed = "Ronnie'd"; break;
				}
			}
			else verbed = "TikTokked"; break;
		default:
			verbed = "killed"; break;
	}
	return verbed;
}
/*
user bool 					CV_b_SB_Chatbot_Enable = true;
user int					CV_n_SB_Charbot_Prefix = 1; // 1: "Playername: ", 2: Custom
user string					CV_s_SB_Chatbot_Prefix = "CHAT: ";
*/
function void SB_Chatbot_Send(str string)
{
	if (GetCVAR("CV_b_SB_Chatbot_Enable"))
	{
		// Format with header
		int prefixStyle = GetCVAR("CV_n_SB_Chatbot_Prefix");
		str prefix;
		
		switch (prefixStyle)
		{
			case 1: prefix = StrParam(n:PlayerNumber(),s:": "); break; // 1: Use Player Chat style
			case 2: prefix = GetCVARString("CV_s_SB_Chatbot_Prefix"); break; // 2: Use custom string
			
		}
		str chatbotData = StrParam(s:prefix,s:string);
		// Send
		// Currently, we use the console log file to transmit the data out.
		Log(s:"\c*",s:chatbotData,s:"\c-");
	}
	return;
}

function void awardUserPoints(str username, int points)
{
	bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	if (verbose) Log(s:"points=",d:points);
	if (verbose) Log(s:"username=",s:username);
	DB_Add(PlayerNumber(), username, points);
	DB_SortByValueAndSave(PlayerNumber());
	return;
}

function void MakeBuddy(int tid)
{
	bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	if (verbose) Log(s:"MakeBuddy(",d:tid,s:")");
	if (tid <= 0) return;
	
	SetActorProperty(tid, APROP_Friendly, TRUE);
	SetActorState(tid, "See", true); // Force into hunting state
	SetActorProperty(tid, APROP_ReactionTime, 1);
	SetActorProperty(tid, APROP_Notarget, FALSE);	
	SetActorFlag(tid, "NOBLOCKMONST", true);
	
	int f_extraSpeed = 11.0;
	SetActorProperty(tid, APROP_Speed, f_extraSpeed);
	Thing_Hate(tid, 0, 6);
	if (verbose) { Log(d:tid,s:" has formed an alliance with ",n:0); }
	int currPlayerCount = PlayerCount();
	if (currPlayerCount > 1)
	{
		for (int j = 0; j < currPlayerCount; j++)
		{
			if (PlayerInGame(j) && !PlayerIsSpectator(j))
			{
				Thing_Hate(tid, j + 1, 6); // 5 = Hate exactly as teammates
				if (verbose) { Log(d:tid,s:" has formed an alliance with ",n:j); }
			}
		}
	}	
	if (verbose) Log(s:"return()");
	return;
}

function str s_formTikTokMarkerSprite (int n_classSize, bool allegianceFriendly)
{
	bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	// Format: TikTok_[Buddy/Enemy]Marker[Short/Tall/Huge/Item]
	//					  	^                      	^
	//						s_alignment				s_spritesize
	// 
	// Also initialize the TID for the marker
	// Add Aura in the future
	str s_alignment; if (allegianceFriendly) s_alignment = "Buddy"; else s_alignment = "Enemy"; 				if (verbose) Log(s:"s_alignment: ",s:s_alignment);
	str s_spritesize;
	switch (n_classSize)
	{
		case 1:	s_spritesize = "Short";	break;
		case 2:	s_spritesize = "Tall";	break;
		case 3:	s_spritesize = "Huge";	break;
		case 4: s_spritesize = "Item";	break;
		default: s_spritesize = ""; 	break;
	}																									if (verbose) Log(s:"s_spritesize: ",s:s_spritesize);
	str s_marker = StrParam(s:"TikTok_",s:s_alignment,s:"Marker",s:s_spritesize); 						if (verbose) Log(s:"s_marker: ",s:s_marker);
	return s_marker;
}
// Helper: show obituary
script 667 (void)
{
	str obituaryText = StrParam(s:"@UserName",s:"\n \n \n+666 points");
	int obituaryID = UniqueTID();
	int obituaryHUDcolor = GetCVAR("CV_n_TF_obituaryHUDcolor");
	int f_obituaryX = GetCVAR("CV_f_TF_obituaryX");
	int f_obituaryY = GetCVAR("CV_f_TF_obituaryY");
	int f_obituaryHoldTime = GetCVAR("CV_f_TF_obituaryHoldTime");
	int f_obituaryTypeTime = GetCVAR("CV_f_TF_obituaryTypeTime");
	int f_obituaryFadeTime = GetCVAR("CV_f_TF_obituaryFadeTime");
	str obituaryFont = GetCVARString("CV_s_TF_obituaryFont");
	SetFont(obituaryFont);
	HUDMessage(s:obituaryText; HUDMSG_TYPEON, obituaryID, obituaryHUDcolor, f_obituaryX, f_obituaryY, f_obituaryHoldTime, f_obituaryTypeTime, f_obituaryFadeTime);	
}

// Helper: Spawn with Marker
// If marker distance > Spawn, marker = .9 * Spawn
script 668 (void)
{
	//CV_f_TF_nametagIconRange_WU
	//CV_f_betterspawn_radialOffset
	int marker = GetCVAR("CV_f_TF_nametagIconRange_WU");
	int spawndist = GetCVAR("CV_f_betterspawn_radialOffset");
	if (marker > spawndist)
	{
		marker = FixedMul(spawndist, 0.6);
		SetCVAR("CV_f_TF_nametagIconRange_WU",marker);
	}
}

// Helper: Spawn with Small Text
// textdraw = spawn * 1.5, % = .30
script 669 (void)
{
	int spawndist = GetCVAR("CV_f_betterspawn_radialOffset");
	int textdraw = FixedMul(spawndist, 1.75);
	int textdraw_px = textdraw >> 16;
	SetCVAR("CV_n_TF_nametagRange", textdraw_px);
	int pct = 0.2;
	SetCVAR("CV_f_TF_nametagFontAutoSP", pct);
}

// Helper: Spawn with Large Text
/*
Example. Spawn is at 100.
Draw text = 1.75x, 150.
Threshold = 0.8 = 140;
Monster spawns in at 100-120, <140, large.
*/
script 670 (void)
{
	int pct = 0.8;
	SetCVAR("CV_f_TF_nametagFontAutoSP", pct);
	int spawndist = GetCVAR("CV_f_betterspawn_radialOffset");
	int textdraw = FixedMul(1.75,spawndist);
	int textdraw_px = textdraw >> 16;
	SetCVAR("CV_n_TF_nametagRange",textdraw_px);
}
// Helper: Spawn with Marker & Small Text
script 671 (void)
{
	int spawndist = GetCVAR("CV_f_betterspawn_radialOffset");
	int marker = FixedMul(spawndist, 0.6);
	SetCVAR("CV_f_TF_nametagIconRange_WU",marker);
	int textdraw = FixedMul(spawndist, 1.75);
	int textdraw_px = textdraw >> 16;
	SetCVAR("CV_n_TF_nametagRange", textdraw_px);
	int pct = 0.2;
	SetCVAR("CV_f_TF_nametagFontAutoSP", pct);
}

function void interactiveSummonFoe(str classname, int size, int points)
{
	if (GetCVAR("CV_b_TF_nametagTikfinity")) SetCVARString("CV_s_TF_sanitized_user","@JohnnyTest123"); 
	else SetCVARString("CV_s_API_summon_username","@JohnnyTest123");
	SetCVARString("CV_s_API_summon_username","@JohnnyTest123"); // CV_s_TF_sanitized_user, CV_s_API_summon_username
	SetCVAR("CV_b_API_summon_buddy", false);
	SetCVAR("CV_n_API_summon_size", size);
	SetCVAR("CV_n_API_summon_points", points);
	SetCVARString("CV_s_API_summon_classname", classname);
	SetCVAR("CV_b_API_dataReady", true);
}
