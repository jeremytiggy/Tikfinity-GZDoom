//#library "Persistence"
//#include "zcommon.acs"

#define MAX_PLAYERS 8
#define MAX_SLOTS   100

str DB_Key[MAX_PLAYERS][MAX_SLOTS];
int DB_Val[MAX_PLAYERS][MAX_SLOTS];

//
// INTERNAL HELPERS
//

function str SlotKeyName(int slot)
{
    if (slot < 10)
        return StrParam(s:"cv_usr_s_0", d:slot);
    return StrParam(s:"cv_usr_s_", d:slot);
}

function str SlotValName(int slot)
{
    if (slot < 10)
        return StrParam(s:"cv_usr_i_0", d:slot);
    return StrParam(s:"cv_usr_i_", d:slot);
}

//
// LOAD PLAYER DATABASE FROM USER CVARS
//

function void DB_LoadPlayer(int pnum)
{
	bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	SetActivatorToPlayer(pnum);

    for (int i = 0; i < MAX_SLOTS; i++)
    {
        DB_Key[pnum][i] = GetCVarString(SlotKeyName(i));
        DB_Val[pnum][i] = GetCVar(SlotValName(i));
		if (verbose) Log(s:"DB_Key[",d:pnum,s:"][",d:i,s:"]=",d:DB_Key[pnum][i],s:", DB_Val[",d:pnum,s:"][",d:i,s:"]=",d:DB_Val[pnum][i],s:"");
    }
	if (debug) Log(s:"DB_LoadPlayer done");
}

//
// PERSIST ONE SLOT
//

function void DB_PersistSlot(int pnum, int slot)
{
    SetActivatorToPlayer(pnum);
	

    SetCVarString(SlotKeyName(slot), DB_Key[pnum][slot]);
    SetCVar(SlotValName(slot), DB_Val[pnum][slot]);
}

//
// FIND OR CREATE SLOT
//

function int DB_FindOrCreate(int pnum, str key)
{
	bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	int empty = -1;

    for (int i = 0; i < MAX_SLOTS; i++)
    {
        if (DB_Key[pnum][i] == key)
            return i;

        if (DB_Key[pnum][i] == "" && empty == -1)
            empty = i;
    }

    if (empty != -1)
    {
        DB_Key[pnum][empty] = key;
        DB_Val[pnum][empty] = 0;

        DB_PersistSlot(pnum, empty);
        return empty;
    }
	if (debug) Log(s:"Persistent Database Full. Unable to track new chat users.");
    return -1; // full
}

//
// PUBLIC SERVER AUTHORITATIVE API
//

function void DB_Add(int pnum, str key, int amount)
{
    int index = DB_FindOrCreate(pnum, key);

    if (index == -1)
        return; // silent fail

    DB_Val[pnum][index] += amount;
    DB_PersistSlot(pnum, index);
}
function void DB_Set(int pnum, str key, int value)
{
	int index = DB_FindOrCreate(pnum, key);

    if (index == -1)
        return; // silent fail
		
	DB_Val[pnum][index] = value;
    DB_PersistSlot(pnum, index);
}
function int DB_Get(int pnum, str key)
{
    for (int i = 0; i < MAX_SLOTS; i++)
    {
        if (DB_Key[pnum][i] == key)
            return DB_Val[pnum][i];
    }

    return 0;
}
function bool DB_Check(int pnum, str key)
{
    for (int i = 0; i < MAX_SLOTS; i++)
    {
        if (DB_Key[pnum][i] == key)
            return true;
    }

    return false;
}
//
// SORT PLAYER DATABASE BY VALUE (DESCENDING)
// AND SAVE ALL SLOTS
//

function void DB_SortByValueAndSave(int pnum)
{
    int i, j;

    // Simple stable bubble sort (small N, safe and predictable)
    for (i = 0; i < MAX_SLOTS - 1; i++)
    {
        for (j = 0; j < MAX_SLOTS - i - 1; j++)
        {
            // Push empty keys downward automatically
            if (DB_Key[pnum][j] == "")
                continue;

            if (DB_Key[pnum][j+1] == "")
                continue;

            if (DB_Val[pnum][j] < DB_Val[pnum][j+1])
            {
                // swap values
                int tempVal = DB_Val[pnum][j];
                DB_Val[pnum][j] = DB_Val[pnum][j+1];
                DB_Val[pnum][j+1] = tempVal;

                // swap keys
                str tempKey = DB_Key[pnum][j];
                DB_Key[pnum][j] = DB_Key[pnum][j+1];
                DB_Key[pnum][j+1] = tempKey;
            }
        }
    }

    // Persist all slots
    for (i = 0; i < MAX_SLOTS; i++)
    {
        DB_PersistSlot(pnum, i);
    }
	
}

//
// SERVER LOAD ON ENTER
//

script 356 ENTER
{
    bool debug = GetCVAR("CV_b_debug");
	bool verbose = GetCVAR("CV_b_verbose") && debug;
	Log(s:"DB_PlayerEnter. Loading Database for Player: ",n:PlayerNumber());
	if (PlayerNumber() >= 0)
        DB_LoadPlayer(PlayerNumber());
	
}
script 357 (void)
{
	DB_SortByValueAndSave(PlayerNumber());
}
script 358 (void)
{
	// Purge
	for (int i = 0; i < MAX_SLOTS; i++)
    {
        DB_Key[PlayerNumber()][i] = "";
		DB_Val[PlayerNumber()][i] = 0;
		DB_PersistSlot(PlayerNumber(), i);
    }
}
script 359 (void)
{
	// Purge the lower 90%
	for (int i = 10; i < MAX_SLOTS; i++)
    {
        DB_Key[PlayerNumber()][i] = "";
		DB_Val[PlayerNumber()][i] = 0;
		DB_PersistSlot(PlayerNumber(), i);
    }
}