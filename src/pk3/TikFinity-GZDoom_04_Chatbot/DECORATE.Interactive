ACTOR TikTok_Marker
{
	+NOBLOCKMAP
	+NOINTERACTION
	+LOOKALLAROUND
	+NOGRAVITY
	Scale 0.3
	States
	{
		Spawn:
			TKTO A 1
			Loop
		SpaceGhost:
			TKTO W 1
			Loop
	}	
}

ACTOR TikTok_MarkerHuge : TikTok_Marker
{
	Scale 0.3
	States
	{
		Spawn:
			TKTO A 1 A_SpriteOffset(0, -105)
			Loop
	}
}
ACTOR TikTok_MarkerTall : TikTok_Marker
{
	Scale 0.26
	States
	{
		Spawn:
			TKTO A 1 A_SpriteOffset(0, -70)
			Loop
	}	
}
ACTOR TikTok_MarkerShort : TikTok_Marker
{
	Scale 0.24
	States
	{
		Spawn:
			TKTO A 1 A_SpriteOffset(0, -50)
			Loop
	}
}
ACTOR TikTok_MarkerItem : TikTok_Marker
{
	Scale 0.24
	States
	{
		Spawn:
			TKTO A 1 A_SpriteOffset(0, -30)
			Loop
	}
}

ACTOR TikTok_EnemyMarker : TikTok_Marker
{
	+FRIENDLY
}

ACTOR TikTok_EnemyMarkerHuge : TikTok_MarkerHuge
{
	+FRIENDLY
}
ACTOR TikTok_EnemyMarkerTall : TikTok_MarkerTall
{
	+FRIENDLY
}
ACTOR TikTok_EnemyMarkerShort : TikTok_MarkerShort
{
	+FRIENDLY
}
ACTOR TikTok_EnemyMarkerItem : TikTok_MarkerItem
{
	+FRIENDLY
}
ACTOR TikTok_BuddyMarker : TikTok_Marker
{
	-FRIENDLY
}
ACTOR TikTok_BuddyMarkerHuge : TikTok_MarkerHuge
{
	-FRIENDLY
}
ACTOR TikTok_BuddyMarkerTall : TikTok_MarkerTall
{
	-FRIENDLY
}
ACTOR TikTok_BuddyMarkerShort : TikTok_MarkerShort
{
	-FRIENDLY
}
Actor TikTok_BuddyMarkerItem : TikTok_MarkerItem
{
	-FRIENDLY
}